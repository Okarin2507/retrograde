<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows build when run on Windows, or anywhere with -p:RetroWindows=true -p:EnableWindowsTargeting=true (cross publish). -->
  <PropertyGroup>
    <RetroWindows Condition="'$(RetroWindows)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">true</RetroWindows>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK projection for System Media Transport Controls (media keys, Windows media card) -->
    <TargetFramework Condition="'$(RetroWindows)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="'$(RetroWindows)' == 'true'">10.0.17763.0</SupportedOSPlatformVersion>
    <!-- Linux: no Windows SDK projection; media keys go through MPRIS (Services/Mpris.cs) -->
    <TargetFramework Condition="'$(RetroWindows)' != 'true'">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Services/TaskbarButtons calls ITaskbarList3 through its vtable (no built-in COM interop, trim-safe) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest Condition="'$(RetroWindows)' == 'true'">app.manifest</ApplicationManifest>
    <AssemblyName>Retrograde</AssemblyName>
    <!-- Shown in the title bar; installer/build.ps1 overrides it with -p:Version. -->
    <Version>2.2.0</Version>
    <Product>Retrograde</Product>
    <AssemblyTitle>Retrograde</AssemblyTitle>
    <RootNamespace>Retrograde.App</RootNamespace>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Release publish: low steady-state CPU and small footprint.
       Preferred: Native AOT (dotnet publish -p:PublishAot=true), which needs the
       "Desktop development with C++" Visual Studio workload for the linker.
       Fallback below works without it: trimmed, self-contained ReadyToRun with tiered
       compilation off, so precompiled code is used as-is and never re-JITted in the background. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier Condition="'$(RetroWindows)' == 'true'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RetroWindows)' != 'true'">linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Linux: Native AOT (clang + lld; measured ~30 MB less PSS and no JIT). Windows keeps trimmed ReadyToRun. -->
    <PublishAot Condition="'$(RetroWindows)' != 'true'">true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishReadyToRun Condition="'$(PublishAot)' != 'true'">true</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <TieredPGO>false</TieredPGO>
    <!-- Measured on Linux after scanning a library: ~30 MB less PSS than the defaults -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebuggerSupport>false</DebuggerSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- NuGet native packages ship ~100MB of .pdb symbols (SkiaSharp, HarfBuzz); keep them out of the publish. -->
  <Target Name="StripPublishedPdbs" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
  <!-- TagLib# finds its file types by reflection; keep the whole assembly when trimming. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="TagLibSharp" />
  </ItemGroup>
  <ItemGroup Condition="'$(RetroWindows)' != 'true'">
    <Compile Remove="Services\MediaControls.cs;Services\TaskbarButtons.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Retrograde.Core\Retrograde.Core.csproj" />
    <ProjectReference Include="..\Retrograde.Audio\Retrograde.Audio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\icon.ico" Link="Assets\icon.ico" />
    <!-- PRIVATE_MEMORY_BANK picture -->
    <AvaloniaResource Include="..\..\assets\kristen.png" Link="Assets\kristen.png" />
    <!-- Not in git, in bin\ at the repository root: libmpv-2.dll (mpv-dev-x86_64 of shinchiro/mpv-winbuild-cmake),
         the in-process engine. mpv.exe is the fallback engine, shipped only when there is no libmpv. -->
    <None Include="..\..\bin\libmpv-2.dll" Link="bin\libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\bin\libmpv-2.dll')" />
    <None Include="..\..\bin\mpv.exe" Link="bin\mpv.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\bin\mpv.exe') And !Exists('..\..\bin\libmpv-2.dll')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
